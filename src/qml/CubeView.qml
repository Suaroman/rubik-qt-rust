import QtQuick
import QtQuick3D
import QtQuick3D.Helpers
import QtQuick3D.Particles3D
import rubik_qt

// The cube, in real 3D. Every transform comes from the Rust engine's snapshot:
//   root node rotation  = engine spin (auto spin + user orbit)
//   cubie node          = slice turn * cubie orientation, at its (turned) grid slot
//   key light direction = engine light vector (the same one the panels report)
// so the picture and the two instrument rails describe the same state.
Item {
    id: cv
    property var frame
    property var info
    property var meshes
    property real explode: 0          // 0 = assembled, 1 = exploded view
    property real zoom: 1.0
    property bool hiQuality: true
    property bool celebrate: true
    // Horizontal centre of the clear strip between the rails, in px.
    property real centerX: width / 2

    readonly property var cubies: frame ? frame.cubies : []
    readonly property real camZ: info ? info.camZ * 100 : 760

    signal clicked()

    function q(a, o) { return Qt.quaternion(a[o], a[o + 1], a[o + 2], a[o + 3]) }

    // Geometry from Rust: flat arrays -> vector3d lists, once.
    function vecs(a) {
        const out = []
        for (let i = 0; i < a.length; i += 3) out.push(Qt.vector3d(a[i], a[i + 1], a[i + 2]))
        return out
    }

    ProceduralMesh {
        id: bodyMesh
        positions: cv.meshes ? cv.vecs(cv.meshes.body.pos) : []
        normals: cv.meshes ? cv.vecs(cv.meshes.body.nrm) : []
        indexes: cv.meshes ? cv.meshes.body.idx : []
    }
    ProceduralMesh {
        id: stickerMesh
        positions: cv.meshes ? cv.vecs(cv.meshes.sticker.pos) : []
        normals: cv.meshes ? cv.vecs(cv.meshes.sticker.nrm) : []
        indexes: cv.meshes ? cv.meshes.sticker.idx : []
    }

    // ---- materials ---------------------------------------------------------
    PrincipledMaterial {
        id: bodyMat
        baseColor: "#121218"
        roughness: 0.52
        metalness: 0.0
        specularAmount: 0.22
    }
    component StickerMat: PrincipledMaterial {
        roughness: 0.2
        metalness: 0.0
        specularAmount: 0.5
        clearcoatAmount: 0.55
        clearcoatRoughnessAmount: 0.08
    }
    StickerMat { id: matU; baseColor: cv.info ? cv.info.palette.U : "white" }
    StickerMat { id: matD; baseColor: cv.info ? cv.info.palette.D : "white" }
    StickerMat { id: matF; baseColor: cv.info ? cv.info.palette.F : "white" }
    StickerMat { id: matB; baseColor: cv.info ? cv.info.palette.B : "white" }
    StickerMat { id: matR; baseColor: cv.info ? cv.info.palette.R : "white" }
    StickerMat { id: matL; baseColor: cv.info ? cv.info.palette.L : "white" }
    readonly property var stickerMats: ({ U: matU, D: matD, F: matF, B: matB, R: matR, L: matL })

    View3D {
        id: view
        anchors.fill: parent
        camera: cam
        renderMode: View3D.Offscreen

        environment: ExtendedSceneEnvironment {
            backgroundMode: SceneEnvironment.Transparent
            antialiasingMode: cv.hiQuality ? SceneEnvironment.MSAA : SceneEnvironment.NoAA
            antialiasingQuality: SceneEnvironment.High
            fxaaEnabled: !cv.hiQuality
            specularAAEnabled: true
            tonemapMode: SceneEnvironment.TonemapModeFilmic
            exposure: 1.0
            // Generated by tools/make_studio_hdr.py: soft boxes for the stickers to reflect.
            lightProbe: Texture { source: "studio.hdr"; mappingMode: Texture.LightProbe }
            probeExposure: 0.9
            probeHorizon: 0.0
            aoEnabled: cv.hiQuality
            aoStrength: 55
            aoDistance: 9
            aoSoftness: 40
            aoSampleRate: 3
            glowEnabled: true
            glowQualityHigh: cv.hiQuality
            glowStrength: 1.0
            glowIntensity: 0.32
            glowBloom: 0.0
            glowHDRMinimumValue: 1.6
            glowHDRScale: 2.0
            glowBlendMode: ExtendedSceneEnvironment.GlowBlendMode.Additive
            glowLevel: ExtendedSceneEnvironment.GlowLevel.Two | ExtendedSceneEnvironment.GlowLevel.Three | ExtendedSceneEnvironment.GlowLevel.Five
            ditheringEnabled: true
        }

        PerspectiveCamera {
            id: cam
            // The original's projection: f = 0.69 * min(w, h) px at CAM_Z.
            readonly property real f: 0.69 * Math.min(view.width, view.height)
            fieldOfViewOrientation: view.width < view.height ? PerspectiveCamera.Horizontal
                                                             : PerspectiveCamera.Vertical
            fieldOfView: 2 * Math.atan((Math.min(view.width, view.height) / 2) / f) * 180 / Math.PI
            z: cv.camZ * cv.zoom
            // Shift the frustum so the cube centres in the clear strip between rails.
            x: (cv.width / 2 - cv.centerX) * (cv.camZ * cv.zoom) / f
            clipNear: 40
            clipFar: 6000
        }

        // Key light: the engine's directional light, with soft shadows so the
        // turning slice shades the block it is leaving.
        DirectionalLight {
            id: key
            rotation: cv.frame ? cv.q(cv.frame.light.q, 0) : Qt.quaternion(1, 0, 0, 0)
            brightness: 1.05
            color: "#fff4e6"
            castsShadow: true
            shadowFactor: 55
            shadowMapQuality: cv.hiQuality ? Light.ShadowMapQualityHigh : Light.ShadowMapQualityMedium
            softShadowQuality: cv.hiQuality ? Light.PCF16 : Light.PCF4
            pcfFactor: 6
            shadowBias: 8
        }
        // Cool rim from behind-left: separates the dark plastic from the background.
        DirectionalLight {
            eulerRotation: Qt.vector3d(-20, -150, 0)
            brightness: 0.35
            color: "#8fb2ff"
        }

        Node {
            id: cubeRoot
            rotation: cv.frame ? cv.q(cv.frame.spin, 0) : Qt.quaternion(1, 0, 0, 0)

            Repeater3D {
                model: 26
                delegate: Node {
                    id: cubie
                    required property int index
                    readonly property int o: index * 7
                    readonly property real spread: 100 * (1 + 0.62 * cv.explode)
                    position: cv.cubies.length ? Qt.vector3d(cv.cubies[o] * spread, cv.cubies[o + 1] * spread, cv.cubies[o + 2] * spread)
                                               : Qt.vector3d(0, 0, 0)
                    rotation: cv.cubies.length ? cv.q(cv.cubies, o + 3) : Qt.quaternion(1, 0, 0, 0)

                    Model {
                        readonly property int cubieIndex: cubie.index
                        readonly property int slot: -1
                        pickable: true
                        geometry: bodyMesh
                        materials: [bodyMat]
                        castsShadows: true
                        receivesShadows: true
                    }
                    Repeater3D {
                        model: cv.info ? cv.info.stickers.filter(s => s[0] === cubie.index) : []
                        delegate: Model {
                            required property var modelData
                            readonly property real nx: modelData[2]
                            readonly property real ny: modelData[3]
                            readonly property real nz: modelData[4]
                            readonly property int cubieIndex: cubie.index
                            readonly property int slot: modelData[5]
                            pickable: true
                            geometry: stickerMesh
                            materials: cv.stickerMats[modelData[1]] ? [cv.stickerMats[modelData[1]]] : [bodyMat]
                            position: Qt.vector3d(nx, ny, nz).times(cv.meshes ? cv.meshes.bodyHalf - 0.15 : 48.5)
                            eulerRotation: nx > 0.5 ? Qt.vector3d(0, 90, 0)
                                         : nx < -0.5 ? Qt.vector3d(0, -90, 0)
                                         : ny > 0.5 ? Qt.vector3d(-90, 0, 0)
                                         : ny < -0.5 ? Qt.vector3d(90, 0, 0)
                                         : nz < -0.5 ? Qt.vector3d(0, 180, 0)
                                         : Qt.vector3d(0, 0, 0)
                            castsShadows: true
                            receivesShadows: true
                        }
                    }
                }
            }

            // Hover inspector: the hovered net cell's cubie, outlined in light.
            // Glowing edges (HDR emissive -> bloom) rather than the original's
            // 2D wireframe, but driven by the same cubie transform.
            Node {
                id: hoverBox
                readonly property int ci: cv.frame ? cv.frame.hoverCubie : -1
                readonly property int o: Math.max(0, ci) * 7
                readonly property real spread: 100 * (1 + 0.62 * cv.explode)
                visible: ci >= 0
                position: ci >= 0 ? Qt.vector3d(cv.cubies[o] * spread, cv.cubies[o + 1] * spread, cv.cubies[o + 2] * spread)
                                  : Qt.vector3d(0, 0, 0)
                rotation: ci >= 0 ? cv.q(cv.cubies, o + 3) : Qt.quaternion(1, 0, 0, 0)
                PrincipledMaterial {
                    id: edgeMat
                    lighting: PrincipledMaterial.NoLighting
                    baseColor: "#e8f2ff"
                    emissiveFactor: Qt.vector3d(3.2, 3.5, 4.0)
                }
                Repeater3D {
                    model: 12
                    delegate: Model {
                        required property int index
                        readonly property int axis: Math.floor(index / 4)
                        readonly property real s1: (index & 1) ? 53 : -53
                        readonly property real s2: (index & 2) ? 53 : -53
                        source: "#Cube"
                        materials: [edgeMat]
                        castsShadows: false
                        scale: axis === 0 ? Qt.vector3d(1.08, 0.014, 0.014)
                             : axis === 1 ? Qt.vector3d(0.014, 1.08, 0.014)
                                          : Qt.vector3d(0.014, 0.014, 1.08)
                        position: axis === 0 ? Qt.vector3d(0, s1, s2)
                                : axis === 1 ? Qt.vector3d(s1, 0, s2)
                                             : Qt.vector3d(s1, s2, 0)
                    }
                }
                Model {
                    source: "#Cube"
                    scale: Qt.vector3d(1.07, 1.07, 1.07)
                    castsShadows: false
                    materials: PrincipledMaterial {
                        lighting: PrincipledMaterial.NoLighting
                        baseColor: Qt.rgba(0.6, 0.8, 1.0, 0.07)
                        alphaMode: PrincipledMaterial.Blend
                        cullMode: Material.NoCulling
                        depthDrawMode: Material.NeverDepthDraw
                    }
                }
            }
        }

        // Solve celebration: a burst of sticker-coloured confetti and a shock ring.
        ParticleSystem3D {
            id: confetti
            component Confetti: ModelParticle3D {
                property color tint: "white"
                maxAmount: 120
                fadeInDuration: 60
                fadeOutDuration: 900
                delegate: Component {
                    Model {
                        source: "#Cube"
                        scale: Qt.vector3d(0.11, 0.11, 0.018)
                        materials: PrincipledMaterial {
                            baseColor: tint
                            roughness: 0.3
                            cullMode: Material.NoCulling
                        }
                    }
                }
            }
            Confetti { id: cU; tint: cv.info ? cv.info.palette.U : "white" }
            Confetti { id: cD; tint: cv.info ? cv.info.palette.D : "white" }
            Confetti { id: cF; tint: cv.info ? cv.info.palette.F : "white" }
            Confetti { id: cB; tint: cv.info ? cv.info.palette.B : "white" }
            Confetti { id: cR; tint: cv.info ? cv.info.palette.R : "white" }
            Confetti { id: cL; tint: cv.info ? cv.info.palette.L : "white" }
            Repeater3D {
                id: bursts
                model: [cU, cD, cF, cB, cR, cL]
                delegate: ParticleEmitter3D {
                    required property var modelData
                    system: confetti
                    particle: modelData
                    emitRate: 0
                    lifeSpan: 2600
                    lifeSpanVariation: 700
                    shape: ParticleShape3D { type: ParticleShape3D.Sphere; extents: Qt.vector3d(150, 150, 150) }
                    velocity: VectorDirection3D {
                        direction: Qt.vector3d(0, 160, 0)
                        directionVariation: Qt.vector3d(520, 420, 520)
                    }
                    particleRotationVariation: Qt.vector3d(180, 180, 180)
                    particleRotationVelocityVariation: Qt.vector3d(420, 420, 420)
                    particleScaleVariation: 0.4
                }
            }
            Gravity3D { magnitude: 260; direction: Qt.vector3d(0, -1, 0) }
        }

    }

    // Solve shockwave: two expanding rings, drawn in 2D over the 3D view.
    Repeater {
        id: waves
        model: 2
        delegate: Rectangle {
            id: wave
            required property int index
            property real s: 1
            readonly property real d: Math.min(cv.width, cv.height) * (0.35 + s * 0.9)
            visible: s < 1
            width: d; height: d; radius: d / 2
            x: cv.centerX - d / 2; y: cv.height / 2 - d / 2
            color: "transparent"
            border.width: 2 + 10 * (1 - s)
            border.color: Qt.rgba(70/255, 224/255, 140/255, 0.55 * (1 - s) * (1 - s))
            NumberAnimation on s { id: wa; running: false; from: 0; to: 1; duration: 1300 + wave.index * 500; easing.type: Easing.OutCubic }
            function go() { wa.restart() }
        }
    }

    property int lastSolves: -1
    onFrameChanged: {
        if (!frame) return
        if (lastSolves >= 0 && frame.solves > lastSolves && celebrate) burst()
        lastSolves = frame.solves
    }
    function burst() {
        for (let i = 0; i < bursts.count; ++i) bursts.objectAt(i).burst(55)
        for (let i = 0; i < waves.count; ++i) waves.itemAt(i).go()
    }

    // ---- interaction: drag to orbit (with inertia), wheel to zoom ----------------
    // ---- interaction: hover to inspect, drag to orbit, wheel to zoom ----------
    property bool hover3d: false        // the current hover came from this view
    property point mouse: Qt.point(0, 0)
    function pickAt(x, y) {
        const r = view.pick(x, y)
        const o = r.objectHit
        if (o && o.cubieIndex !== undefined) {
            Rubik.hoverSticker(o.cubieIndex, o.slot)
            hover3d = true
        } else if (hover3d) {
            Rubik.setHover(-1)
            hover3d = false
        }
    }

    MouseArea {
        id: mouseArea
        anchors.fill: parent
        acceptedButtons: Qt.LeftButton
        hoverEnabled: true
        property point last
        property real vx: 0
        property real vy: 0
        property double lastT: 0
        cursorShape: pressed ? Qt.ClosedHandCursor : (cv.hover3d ? Qt.PointingHandCursor : Qt.OpenHandCursor)
        onPressed: (m) => { last = Qt.point(m.x, m.y); vx = 0; vy = 0; lastT = Date.now() }
        onExited: if (cv.hover3d) { Rubik.setHover(-1); cv.hover3d = false }
        onPositionChanged: (m) => {
            cv.mouse = Qt.point(m.x, m.y)
            if (!pressed) { cv.pickAt(m.x, m.y); return }
            const dx = m.x - last.x, dy = m.y - last.y
            const now = Date.now(), dt = Math.max(1, now - lastT) / 1000
            vx = 0.7 * vx + 0.3 * dx / dt
            vy = 0.7 * vy + 0.3 * dy / dt
            lastT = now
            last = Qt.point(m.x, m.y)
            Rubik.orbitBy(dx, dy)
        }
        onReleased: {
            const idle = (Date.now() - lastT) > 90
            Rubik.releaseOrbit(idle ? 0 : vx, idle ? 0 : vy)
        }
        onDoubleClicked: { Rubik.resetView(); cv.zoom = 1 }
        onWheel: (w) => { cv.zoom = Math.max(0.55, Math.min(2.2, cv.zoom * Math.pow(0.9, w.angleDelta.y / 120))) }
    }
    // Re-pick while the mouse rests: the cube keeps turning underneath it.
    Timer {
        interval: 100; repeat: true
        running: mouseArea.containsMouse && !mouseArea.pressed
        onTriggered: cv.pickAt(cv.mouse.x, cv.mouse.y)
    }

    // Inspector tooltip next to the pointer (same three lines as the net's).
    Rectangle {
        readonly property var ins: cv.frame && cv.frame.dna ? cv.frame.dna.inspect : null
        visible: cv.hover3d && ins !== null && !mouseArea.pressed
        x: Math.min(cv.width - width - 8, cv.mouse.x + 18)
        y: Math.max(8, cv.mouse.y - height - 10)
        width: tipCol.width + 14; height: tipCol.height + 10
        radius: 3
        color: Qt.rgba(9/255, 11/255, 16/255, 0.92)
        border.color: Qt.rgba(158/255, 176/255, 214/255, 0.35)
        Column {
            id: tipCol
            x: 7; y: 5; spacing: 2
            Repeater {
                model: 3
                delegate: Label2 {
                    required property int index
                    text: parent.parent.ins ? parent.parent.ins.lines[index] : ""
                    px: 9.5; color: index === 0 ? "#dfe7f6" : "#8f9bb8"
                }
            }
        }
    }

    Behavior on zoom { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
}
